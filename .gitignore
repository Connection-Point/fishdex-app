# ---------------------------------------------------------------
# FishDex app (Flutter, Android) — .gitignore
# ---------------------------------------------------------------

# Flutter / Dart build output & caches
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
.widget_preview/
migrate_working_dir/

# Symbols & obfuscation maps from release builds (keep them in a safe place, not in git)
app.*.symbols
app.*.map.json
/symbols/
/debug-info/

# Android build artifacts
/android/app/debug
/android/app/profile
/android/app/release
*.apk
*.aab

# Signing & secrets — NEVER commit these
/android/key.properties
**/*.keystore
**/*.jks
*.p12
.env
.env.*
!.env.example
# Firebase config is environment-specific; keep it out of a shared repo
/android/app/google-services.json
/android/app/src/*/google-services.json
# Local dart-define files (API URLs, OAuth client IDs)
dart_defines*.json
!dart_defines.example.json

# Android Studio / Gradle local state (android/.gitignore covers the rest)
/android/local.properties
/android/.gradle
/android/captures/
/android/.kotlin/

# IDEs & editors
*.iml
*.ipr
*.iws
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.history
.atom/
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Misc
*.class
*.log
*.pyc
.svn/
